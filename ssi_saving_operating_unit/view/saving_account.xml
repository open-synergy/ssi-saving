<odoo>

<!-- TREE VIEW -->
<record id="saving_account_view_tree" model="ir.ui.view">
    <field name="name">saving_account tree</field>
    <field name="model">saving_account</field>
    <field name="inherit_id" ref="ssi_saving.saving_account_view_tree" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                        optional="hide"
                    />
            </xpath>
        </data>
    </field>
</record>

<!-- SEARCH VIEW -->
<record id="saving_account_view_search" model="ir.ui.view">
    <field name="name">saving_account search</field>
    <field name="model">saving_account</field>
    <field name="inherit_id" ref="ssi_saving.saving_account_view_search" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                    />
            </xpath>
            <xpath expr="//filter[@name='grp_company']" position="after">
                <filter
                        name="grp_ou"
                        string="Operating Unit"
                        context="{'group_by':'operating_unit_id'}"
                        groups="operating_unit.group_multi_operating_unit"
                    />
            </xpath>
        </data>
    </field>
</record>

<!-- FORM VIEW -->
<record id="saving_account_view_form" model="ir.ui.view">
    <field name="name">saving_account form</field>
    <field name="model">saving_account</field>
    <field name="inherit_id" ref="ssi_saving.saving_account_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                    />
            </xpath>
        </data>
    </field>
</record>

</odoo>
